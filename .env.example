# Copy to .env and replace values locally. Never commit .env.
# All values below are placeholders. Do not reuse them outside a local test stack.

# Compose stack (docker-compose.yml)
POSTGRES_DB=surgitwin
POSTGRES_USER=surgitwin
POSTGRES_PASSWORD=changeme

# Runtime environment policy (production is the default and fails closed)
ENVIRONMENT=production

# JWT signing secret (NFR-SEC-001). Set exactly one of JWT_SECRET or JWT_SECRET_FILE.
JWT_SECRET=
JWT_SECRET_FILE=

# Compliance database connection (FR-DAT-003). Required when ENVIRONMENT=production.
DATABASE_URL=postgresql+psycopg2://surgitwin:changeme@localhost:5432/surgitwin

# Database TLS (NFR-SEC-001). Gateway R2 is open: the compose stack defaults to disable.
DB_SSLMODE=disable
DB_SSLROOTCERT=
DB_SSLCERT=
DB_SSLKEY=

# Database reconnection backoff (NFR-R3)
DB_RECONNECT_MAX_ATTEMPTS=5
DB_RECONNECT_BASE_DELAY=0.5
DB_RECONNECT_MAX_DELAY=30.0

# Pulse physiology engine (FR-MS-006)
PULSE_DATA_ROOT=/pulse/bin
# Set to 1 only to force deterministic seed synthesis instead of the native engine.
BIOSSYNC_SYNTHETIC=0

# Qualification tests (vv/tests and middleware/tests). Point these at disposable databases only.
# The compose stack creates only POSTGRES_DB and POSTGRES_USER. Create the test database once with:
#   docker exec <postgres container> psql -U surgitwin -d surgitwin -c "CREATE DATABASE surgitwin_test OWNER surgitwin;"
BIOSYNC_TEST_DATABASE_URL=postgresql+psycopg2://surgitwin:changeme@localhost:5432/surgitwin_test
BIOSYNC_PQ3_DATABASE_URL=
