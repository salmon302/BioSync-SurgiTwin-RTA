<?xml version="1.0"?>
<!--
  G2.2 pinned reference scene (DEVELOPMENT_PLAN.md task 2.2, SRS FR-MS-002).

  Hyperelastic FEM parenchymal organ under gravity with an implicit solver
  chain: EulerImplicitSolver + PCGLinearSolver. The SparseLDLSolver direct
  chain from the bundled Heterogeneous-TetrahedronFEMForceField example was
  probed first and measured 17.2 to 19.6 ms per step on this mesh (over the
  16.7 ms frame budget), so the iterative chain replaced it; both are bundled
  example patterns from the pinned SOFA v26.06.00 install.

  Mesh input (task 2.2 slice 3): the G2.1 liver envelope (parenchyma_liver,
  chain v4) decimated onto a 20 mm grid by sim/sofa/src/prepare_g21_meshes.py,
  giving 405 nodes and 1230 tetrahedra (the budget-fit level, selected 2026-11-06; 16, 17, 18, and 19 mm levels are recorded in SNDEV/docs/impl-2026-11-06-g22-budget-fit.md). The decimation parameters, source
  checksums, and output checksums are in meshes/g21_provenance.json. The
  1296-tet placeholder block of generate_reference_mesh.py is retired.

  Frame: scene y is superior and gravity is -y. The base fixation is the
  inferior node plane, the same analog as the placeholder base slab. This is a
  timing reference geometry, not a clinical attachment model.

  Tumor stiffness: the Parenchyma and Tumor child nodes each carry their own
  TetrahedronSetTopologyContainer (disjoint tetra subsets of the same node
  list). The Parenchyma node carries a TetrahedronHyperelasticityFEMForceField
  on the shared parent MechanicalObject. The tumor ParameterSet is five times
  the parenchyma ParameterSet in both Lame constants. The tumor node is empty on
  HCC_001 (tumor_hypoattenuating has zero voxels), so its subset holds no tets
  and its force field is omitted (the node and topology container stay).

  Material: the parenchyma ParameterSet is the slice-1 placeholder value, kept
  unchanged for comparability. Patient-specific parameterization is a later
  task.

  Mass: the parenchyma density of 1000 kg/m^3 over the decimated envelope
  volume (0.00164 m^3) gives 1.640000 kg. The slice-1 mass was 0.064 kg for
  the 0.04 m placeholder cube.

  Vascular keep-out: the VasculatureKeepOut node holds the keep-out boundary
  points on a 5 mm lattice only. It has no force field, no mass, and no
  mapping, so there is no material coupling yet. The keep-out survives the
  20 mm decimation as a signed distance field at every scene node
  (meshes/keepout_distance_nodes.json, negative inside the keep-out including
  the 1.0 mm margin). Coupling feeds the FR-RTA-003 envelope in a later task.

  Resolution boundary: the scene resolution (decimation cell size, 20 mm
  here) is a documented design parameter. The full-resolution G2.1 geometry
  stays in the offline and reduced-order path (bridge modal coefficients, FMU
  reduced-order models). With this solver chain (25 PCG iterations), the scene
  is validated only at the scanned stable levels 16, 17, 18, and 20 mm. The
  15 and 19 mm levels invert elements under this chain (PCG breakdown) and are
  not valid reference scenes.

  Changing this scene re-opens gate G2.2: it is THE pinned reference scene.
  Mesh inputs are regenerated with prepare_g21_meshes.py.
-->
<Node name="root" dt="0.001" gravity="0 -9.81 0">
    <RequiredPlugin pluginName="Sofa.Component.AnimationLoop"/>
    <RequiredPlugin pluginName="Sofa.Component.Constraint.Projective"/>
    <RequiredPlugin pluginName="Sofa.Component.Engine.Select"/>
    <RequiredPlugin pluginName="Sofa.Component.IO.Mesh"/>
    <RequiredPlugin pluginName="Sofa.Component.LinearSolver.Iterative"/>
    <RequiredPlugin pluginName="Sofa.Component.Mass"/>
    <RequiredPlugin pluginName="Sofa.Component.ODESolver.Backward"/>
    <RequiredPlugin pluginName="Sofa.Component.Playback"/>
    <RequiredPlugin pluginName="Sofa.Component.SolidMechanics.FEM.HyperElastic"/>
    <RequiredPlugin pluginName="Sofa.Component.StateContainer"/>
    <RequiredPlugin pluginName="Sofa.Component.Topology.Container.Dynamic"/>
    <RequiredPlugin pluginName="Sofa.Component.Visual"/>

    <VisualStyle displayFlags="showBehaviorModels showForceFields"/>
    <DefaultAnimationLoop name="animationLoop"/>

    <Node name="ReferenceOrgan">
        <MeshGmshLoader name="organLoader" filename="meshes/reference_organ.msh"/>
        <TetrahedronSetTopologyContainer name="organTopology" src="@organLoader"/>
        <TetrahedronSetTopologyModifier name="organModifier"/>
        <TetrahedronSetGeometryAlgorithms name="organGeometry"/>
        <MechanicalObject name="organState" src="@organLoader"/>

        <!-- Parenchyma density 1000 kg/m^3 over the 0.00164 m^3 decimated liver envelope (20 mm grid). -->
        <MeshMatrixMass name="organMass" totalMass="1.640000"/>

        <EulerImplicitSolver name="implicitSolver" rayleighMass="0.1" rayleighStiffness="0.1"/>
        <PCGLinearSolver name="linearSolver" iterations="25" tolerance="1e-9"/>

        <!-- Fix the inferior node plane (y = 0, 21 nodes) so the organ deforms under
             gravity without drifting. Box from meshes/g21_provenance.json scene.base_fixation_box_m. -->
        <BoxROI name="baseFixation" box="-0.0005 -0.0005 -0.0005 0.2005 0.0005 0.1805" drawBoxes="0"/>
        <FixedProjectiveConstraint name="baseFixed" indices="@baseFixation.indices"/>

        <!-- Positions dumped every 10 ms for the harness divergence check. -->
        <WriteState name="stateDump" filename="positions.out" period="0.01" time="0" writeX="1" writeV="0"/>

        <Node name="Parenchyma">
            <MeshGmshLoader name="parenchymaLoader" filename="meshes/reference_organ_parenchyma.msh"/>
            <TetrahedronSetTopologyContainer name="parenchymaTopology" src="@parenchymaLoader"/>
            <TetrahedronHyperelasticityFEMForceField name="parenchymaMaterial" materialName="NeoHookean" ParameterSet="1785.714286 7142.857143"/>
        </Node>

        <Node name="Tumor">
            <MeshGmshLoader name="tumorLoader" filename="meshes/reference_organ_tumor.msh"/>
            <TetrahedronSetTopologyContainer name="tumorTopology" src="@tumorLoader"/>
            <!-- Unpopulated on HCC_001: the subset holds zero tets, so the tumor force field
                 is omitted (SOFA reports an error for a force field with no tets). The
                 tumor ParameterSet is 5x the parenchyma in both Lame constants
                 (8928.571429 35714.285714) and applies once a tumor mesh is populated. -->
        </Node>
    </Node>

    <Node name="VasculatureKeepOut">
        <MeshGmshLoader name="keepOutLoader" filename="meshes/vessel_keepout_points.msh"/>
        <MechanicalObject name="keepOutPoints" src="@keepOutLoader"/>
    </Node>
</Node>
