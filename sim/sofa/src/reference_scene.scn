<?xml version="1.0"?>
<!--
  G2.2 pinned reference scene (DEVELOPMENT_PLAN.md task 2.2, SRS FR-MS-002).

  Hyperelastic FEM parenchymal organ under gravity with an implicit solver
  chain: EulerImplicitSolver + PCGLinearSolver. The SparseLDLSolver direct
  chain from the bundled Heterogeneous-TetrahedronFEMForceField example was
  probed first and measured 17.2 to 19.6 ms per step on this mesh (over the
  16.7 ms frame budget), so the iterative chain replaced it; both are bundled
  example patterns from the pinned SOFA v26.06.00 install.

  Tumor stiffness: the Parenchyma and Tumor child nodes each carry their own
  TetrahedronSetTopologyContainer (disjoint tetra subsets of the same node
  list, generated by generate_reference_mesh.py) and their own
  TetrahedronHyperelasticityFEMForceField on the shared parent MechanicalObject.
  The tumor ParameterSet is five times the parenchyma ParameterSet in both
  Lame constants.

  Vascular keep-out: the VasculatureKeepOut node holds centerline scene
  geometry only. It has no force field, no mass, and no mapping, so there is
  no material coupling yet. Coupling feeds the FR-RTA-003 envelope in a later
  task.

  Changing this scene re-opens gate G2.2: it is THE pinned reference scene.
  Mesh inputs are regenerated with generate_reference_mesh.py.
-->
<Node name="root" dt="0.001" gravity="0 -9.81 0">
    <RequiredPlugin pluginName="Sofa.Component.AnimationLoop"/>
    <RequiredPlugin pluginName="Sofa.Component.Constraint.Projective"/>
    <RequiredPlugin pluginName="Sofa.Component.Engine.Select"/>
    <RequiredPlugin pluginName="Sofa.Component.IO.Mesh"/>
    <RequiredPlugin pluginName="Sofa.Component.LinearSolver.Iterative"/>
    <RequiredPlugin pluginName="Sofa.Component.Mass"/>
    <RequiredPlugin pluginName="Sofa.Component.ODESolver.Backward"/>
    <RequiredPlugin pluginName="Sofa.Component.Playback"/>
    <RequiredPlugin pluginName="Sofa.Component.SolidMechanics.FEM.HyperElastic"/>
    <RequiredPlugin pluginName="Sofa.Component.StateContainer"/>
    <RequiredPlugin pluginName="Sofa.Component.Topology.Container.Dynamic"/>
    <RequiredPlugin pluginName="Sofa.Component.Visual"/>

    <VisualStyle displayFlags="showBehaviorModels showForceFields"/>
    <DefaultAnimationLoop name="animationLoop"/>

    <Node name="ReferenceOrgan">
        <MeshGmshLoader name="organLoader" filename="meshes/reference_organ.msh"/>
        <TetrahedronSetTopologyContainer name="organTopology" src="@organLoader"/>
        <TetrahedronSetTopologyModifier name="organModifier"/>
        <TetrahedronSetGeometryAlgorithms name="organGeometry"/>
        <MechanicalObject name="organState" src="@organLoader"/>

        <!-- Parenchyma density 1000 kg/m^3 over the 0.04 m cube: 0.064 kg. -->
        <MeshMatrixMass name="organMass" totalMass="0.064"/>

        <EulerImplicitSolver name="implicitSolver" rayleighMass="0.1" rayleighStiffness="0.1"/>
        <PCGLinearSolver name="linearSolver" iterations="25" tolerance="1e-9"/>

        <!-- Fix the base slab (y in [0, 0.001]) so the organ deforms under
             gravity without drifting. -->
        <BoxROI name="baseFixation" box="-0.001 -0.001 -0.001 0.041 0.001 0.041" drawBoxes="0"/>
        <FixedProjectiveConstraint name="baseFixed" indices="@baseFixation.indices"/>

        <!-- Positions dumped every 10 ms for the harness divergence check. -->
        <WriteState name="stateDump" filename="positions.out" period="0.01" time="0" writeX="1" writeV="0"/>

        <Node name="Parenchyma">
            <MeshGmshLoader name="parenchymaLoader" filename="meshes/reference_organ_parenchyma.msh"/>
            <TetrahedronSetTopologyContainer name="parenchymaTopology" src="@parenchymaLoader"/>
            <TetrahedronHyperelasticityFEMForceField name="parenchymaMaterial" materialName="NeoHookean" ParameterSet="1785.714286 7142.857143"/>
        </Node>

        <Node name="Tumor">
            <MeshGmshLoader name="tumorLoader" filename="meshes/reference_organ_tumor.msh"/>
            <TetrahedronSetTopologyContainer name="tumorTopology" src="@tumorLoader"/>
            <!-- 5x stiffer than the parenchyma in both Lame constants. -->
            <TetrahedronHyperelasticityFEMForceField name="tumorMaterial" materialName="NeoHookean" ParameterSet="8928.571429 35714.285714"/>
        </Node>
    </Node>

    <Node name="VasculatureKeepOut">
        <MeshGmshLoader name="keepOutLoader" filename="meshes/vessel_keepout_centerline.msh"/>
        <MechanicalObject name="keepOutCenterline" src="@keepOutLoader"/>
    </Node>
</Node>
